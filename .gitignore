# britive/onboarding — keep this file short and scoped.
# Rules are path-scoped where possible so a future bin/, lib/ or scripts/
# directory is never silently ignored (the previous template-generated
# file hid Britive Bridge/custom-image/scripts/ from every clone).

# OS / editors / agent state
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Real variable files hold tenant names and secrets; only the examples are tracked.
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.example.tfvars
# Google Cloud key mode writes an org-wide service account key here.
terraform/google-cloud/keys/
terraform/keys/

# Secrets and local working copies (never commit)
.env
.env.*
!.env.example
**/secrets.json
!**/secrets.json.example
service_account_creds.json
python/britive/data_input.yaml
python/britive/data_input.json
# Broker SSH key pair for the session-recording docker variant — both halves.
session-recording/docker/broker-ssh/*
!session-recording/docker/broker-ssh/.gitkeep
# Filled-in CloudFormation parameter files and downloaded SAML metadata.
# Tracked templates are named parameters.example.json.
cloudformation/**/parameters.json
cloudformation/**/metadata.xml
# Rendered Kubernetes manifests produced by deploy scripts.
**/*-rendered.yaml
**/*.yaml.bak

# Binaries and archives
*.jar
*.zip
*.tar.gz

# Local scratch
sample.py
