# Copy to .env (gitignored). docker compose reads it automatically.

# Tenant subdomain only — "acme" for https://acme.britive-app.com
BRITIVE_BROKER_TENANT_SUBDOMAIN=your-tenant

# Broker pool token: System Administration > Brokers and Broker Pools > your pool > Tokens
BRITIVE_BROKER_AUTH_TOKEN=

# Image built from ../image (local tag or the one build-and-push.sh pushed)
BROKER_IMAGE=britive-broker:local

# text | json
BRITIVE_BROKER_LOG_FORMAT=text
