{
  "_comment": "Britive Session Recording - Secrets Configuration",
  "_description": "Define secrets to be stored in AWS Secrets Manager and injected into ECS tasks at runtime",
  "_instructions": "Copy this file to secrets.json, fill in your values, then run ./deploy.sh",

  "secrets": {
    "BRITIVE_TENANT": {
      "description": "Britive tenant subdomain (e.g. 'mycompany' for mycompany.britive-app.com) — find it in System Administration > Settings",
      "value": "your-tenant-subdomain-here",
      "required": true,
      "inject_as": "env"
    },
    "BRITIVE_TOKEN": {
      "description": "Britive broker pool authentication token — find it in System Administration > Broker Pools",
      "value": "your-britive-token-here",
      "required": true,
      "inject_as": "env"
    },
    "JSON_SECRET_KEY": {
      "description": "Secret key for Guacamole JSON authentication extension — leave empty to auto-generate during deploy",
      "value": "",
      "required": true,
      "inject_as": "env"
    },
    "KUBECONFIG_BASE64": {
      "description": "Base64-encoded kubeconfig for external Kubernetes clusters (optional)",
      "value": "",
      "required": false,
      "inject_as": "env"
    }
  },

  "_custom_secrets_comment": "Add additional secrets below as needed. They will be available as environment variables in the broker container.",
  "custom_secrets": {
  }
}
