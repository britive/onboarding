# Copy to .env (gitignored). docker compose reads it automatically.

# Guacamole JSON auth key: a 128-bit AES key written as 32 hex characters.
# Generate with:  openssl rand -hex 16
# The same value goes into SECRET_KEY in every checkout script (SECRET /
# json_secret_key variable in the Britive permission).
JSON_SECRET_KEY=

# Password for the guacamole_db PostgreSQL user (connection history and
# in-browser recording playback).
POSTGRES_PASSWORD=

# Optional. Only used by broker/bootstrap/token-generator.sh; the tracked
# setup reads the broker token from broker/broker-config.yml instead.
BRITIVE_TOKEN=
