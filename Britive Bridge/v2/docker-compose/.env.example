# Copy to .env and fill in. .env is gitignored; never commit it.

# Britive tenant subdomain only — "acme" for https://acme.britive-app.com
BRITIVE_TENANT=your-tenant

# Broker pool token — printed by ../../platform-setup/quick-setup.py
BRITIVE_BROKER_AUTH_TOKEN=

# PostgreSQL password for the bundled postgres service
POSTGRES_PASSWORD=

# Generate once and keep forever:  openssl rand -base64 32
# Rotating it after go-live makes every stored checkout payload unreadable.
BRIDGE_ENCRYPTION_KEY_B64=

# Required whenever the broker is enabled:  openssl rand -hex 32
BRIDGE_CLUSTER_TOKEN=

# Recommended, keeps the SSH host-key fingerprint stable:  openssl rand -hex 16
BRIDGE_HOST_KEY_SEED=

# Public URL users reach Bridge at (scheme + host, no path). Used to build the
# Britive OAuth redirect_uri. Leave empty when testing on https://localhost.
BRIDGE_URL=

# Optional: a custom image built with ../../custom-image/ (extra CLI tools).
# BRIDGE_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/britive/bridge:v2.3.1-r1
