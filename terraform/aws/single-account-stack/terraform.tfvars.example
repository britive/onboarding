# Copy to terraform.tfvars (gitignored) and fill in.

tenant_name = "your-tenant" # the part before .britive-app.com

# The SAML metadata XML itself. Easiest: leave this line out and pass the file
# on the command line:
#   terraform apply -var="saml_metadata_document_xml_content=$(cat britive-saml-metadata.xml)"
saml_metadata_document_xml_content = "<paste the XML here, or pass it with -var as shown above>"

deploy_aws_invalidation_feature = true
deploy_access_builder           = false
deploy_ai_identity_scanning     = false
deploy_sample_roles             = false
max_session_duration            = 3600
region                          = "us-east-1"

# Management account only: the AWS Identity Center and AWS Account Access
# application types. The ARN comes from the account access manager Settings
# page (arn:aws:account-access:...), not from IAM Identity Center (arn:aws:sso::).
deploy_identity_center         = false
deploy_account_access          = false
account_access_application_arn = ""
