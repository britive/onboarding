# Copy to terraform.tfvars (gitignored) and fill in.

tenant_name = "your-tenant" # the part before .britive-app.com

# Pass the metadata on the command line instead of pasting it here:
#   terraform apply -var="saml_metadata_document_xml_content=$(cat britive-saml-metadata.xml)"
saml_metadata_document_xml_content = "<paste the XML here, or pass it with -var as shown above>"

# Only this CIDR can reach the instances and the database. Your public IP:
#   curl -s https://checkip.amazonaws.com
allowed_ingress_cidr = "203.0.113.10/32"

deploy_aws_invalidation_feature = true
region                          = "us-east-1"

# Optional: your own public key. Leave empty and Terraform generates a key pair.
# ssh_public_key = "ssh-ed25519 AAAA..."
